# Configure cada ambiente no projeto Vercel; não envie arquivos .env no deploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Somente em .env.test.local, para testes reais de desenvolvimento:
FINANCY_DEV_PROJECT_REF=
# A integração cria sessões reais com contas efêmeras; não configure senhas aqui.
# FINANCY_DEV_PROJECT_REF não é variável VITE_ e não é necessária na Vercel.
# Nunca prefixar tokens administrativos, service_role ou senhas com VITE_.
